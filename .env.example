# ===== LLM (pilih salah satu: gemini | groq | ollama) =====
LLM_PROVIDER=groq
# Cadangan otomatis bila provider utama gagal/sibuk (yang API key-nya kosong dilewati)
# Rantai cadangan. Layanan cloud lain yang key-nya terisi otomatis ikut di belakang (Ollama hanya bila ditulis).
LLM_FALLBACK_PROVIDERS=groq,gemini,cerebras,openrouter,mistral
# BANYAK KEY = kuota berlipat & tidak macet. Tiap key dari AKUN berbeda. Dua cara (boleh dicampur):
#   GROQ_API_KEY=gsk_aaa,gsk_bbb        atau        GROQ_API_KEY_2=gsk_ccc  (s.d. _20)
# Key yang kena limit otomatis diistirahatkan, key berikutnya langsung dipakai. Berlaku untuk
# GEMINI_API_KEY, GROQ_API_KEY, CEREBRAS_API_KEY, OPENROUTER_API_KEY, MISTRAL_API_KEY, POLLINATIONS_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cadangan bila model utama sibuk (503) atau dipensiunkan (404), dicoba berurutan
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# Cadangan gratis tambahan (kompatibel OpenAI) — isi bila mau, kosong = dilewati:
#   cloud.cerebras.ai · openrouter.ai/keys · console.mistral.ai
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# CEREBRAS_MODELS=gpt-oss-120b,llama-3.3-70b,qwen-3-32b
# OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free
# MISTRAL_MODELS=mistral-small-latest,open-mistral-nemo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== Cloudflare Workers AI (gratis 10rb Neuron/hari) — LLM cadangan + gambar AI FLUX (utama) =====
# dash.cloudflare.com → Account ID (kolom kanan) → My Profile → API Tokens → template "Workers AI".
# Banyak akun: CLOUDFLARE_API_KEY=<account_id>:<token>,<account_id2>:<token2>
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODELS=@cf/openai/gpt-oss-120b,@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ===== Stock footage gratis =====
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Opsional: foto B-roll lebih bagus (gratis, unsplash.com/developers → Access Key)
UNSPLASH_ACCESS_KEY=

# ===== Whisper (tiny | base | small | medium | large-v3) =====
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ===== Google =====
# File OAuth "Desktop app" dari Google Cloud Console
GOOGLE_CLIENT_SECRET=credentials/client_secret.json
GOOGLE_TOKEN=credentials/token.json
# ID spreadsheet database (kosongkan -> dibuat otomatis saat setup)
SHEET_ID=
# ID folder root di Google Drive (kosongkan -> dibuat otomatis "Shiroe Syn Studio")
DRIVE_ROOT_FOLDER_ID=
# Folder library audio bebas royalti: berisi subfolder per mood (tegang, ceria, dramatis, ...)
DRIVE_MUSIC_FOLDER_ID=
DRIVE_SFX_FOLDER_ID=

# ===== Cerita AI (gambar AI + karakter konsisten) =====
# Key gratis: https://enter.pollinations.ai (format sk_...). Tanpa key: konsistensi karakter terbatas & lambat.
POLLINATIONS_KEY=
STORY_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# ===== Lain-lain =====
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DEFAULT_LANGUAGE=id
HOST=127.0.0.1
PORT=8000
# Mode tablet: HOST=0.0.0.0 lalu buka http://IP-laptop:8000 di tablet. Perangkat lain wajib PIN
# (kosong = PIN acak tiap start, ditampilkan di terminal).
# APP_PIN=123456
# UI GitHub Pages yang boleh mengakses backend lokal ini
CORS_ORIGINS=https://shiroesyn202601-ship-it.github.io

# Clipper: berapa klip dikerjakan bersamaan saat produksi massal (1 = berurutan, default 3, maks 6)
CLIP_WORKERS=3
