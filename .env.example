# ===== LLM (pilih salah satu: gemini | groq | ollama) =====
LLM_PROVIDER=gemini
# Cadangan otomatis bila provider utama gagal/sibuk (yang API key-nya kosong dilewati)
LLM_FALLBACK_PROVIDERS=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cadangan bila model utama sibuk (503) atau dipensiunkan (404), dicoba berurutan
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== Stock footage gratis =====
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ===== Whisper (tiny | base | small | medium | large-v3) =====
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ===== Google =====
# File OAuth "Desktop app" dari Google Cloud Console
GOOGLE_CLIENT_SECRET=credentials/client_secret.json
GOOGLE_TOKEN=credentials/token.json
# ID spreadsheet database (kosongkan -> dibuat otomatis saat setup)
SHEET_ID=
# ID folder root di Google Drive (kosongkan -> dibuat otomatis "Shiroe Syn Studio")
DRIVE_ROOT_FOLDER_ID=
# Folder library audio bebas royalti: berisi subfolder per mood (tegang, ceria, dramatis, ...)
DRIVE_MUSIC_FOLDER_ID=
DRIVE_SFX_FOLDER_ID=

# ===== Lain-lain =====
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
DEFAULT_LANGUAGE=id
HOST=127.0.0.1
PORT=8000
# UI GitHub Pages yang boleh mengakses backend lokal ini
CORS_ORIGINS=https://shiroesyn202601-ship-it.github.io
